export const JobBoard: React.FC = () => {
  const [view, setView] = useState<'feed' | 'create' | 'details'>('feed');
  const [selectedJob, setSelectedJob] = useState<Job | null>(null);

  const handleJobClick = (job: Job) => {
    setSelectedJob(job);
    setView('details');
  };

  return (
    <div className="space-y-8">
      {view === 'feed' && (
        <>
          <header className="flex items-center justify-between">
            <h1 className="text-4xl font-extrabold tracking-tight text-white uppercase italic">
              Service <span className="text-blue-400">Gigs</span>
            </h1>
            <button 
              onClick={() => setView('create')}
              className="p-4 bg-blue-600 text-white rounded-2xl shadow-xl shadow-blue-500/20 active:scale-95 transition-transform"
            >
              <Plus size={24} />
            </button>
          </header>

          <div className="flex gap-3 overflow-x-auto pb-4 no-scrollbar">
            {['All', 'Writing', 'Design', 'Errands', 'Coding'].map((cat) => (
              <button 
                key={cat} 
                className="px-6 py-3 bg-[#111114] border border-white/5 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 hover:text-white hover:border-white/10 transition-all whitespace-nowrap"
              >
                {cat}
              </button>
            ))}
          </div>

          <div className="space-y-5">
            {MOCK_JOBS.map((job) => (
              <JobCard key={job.id} job={job} onClick={() => handleJobClick(job)} />
            ))}
          </div>
        </>
      )}

      {view === 'create' && (
        <CreateJobView onBack={() => setView('feed')} />
      )}

      {view === 'details' && selectedJob && (
        <JobDetailsView job={selectedJob} onBack={() => setView('feed')} />
      )}
    </div>
  );
};

const JobCard: React.FC<{ job: Job; onClick: () => void }> = ({ job, onClick }) => {
