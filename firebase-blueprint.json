      onClick={onClick}
      className="group p-6 bg-[#111114] border border-white/5 rounded-[2.5rem] shadow-xl hover:bg-white/5 transition-all duration-300 cursor-pointer relative overflow-hidden"
    >
      <div className="absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity">
         <Briefcase size={80} className="text-blue-400 rotate-12" />
      </div>
      <div className="relative z-10">
        <div className="flex justify-between items-start mb-4">
          <span className="text-[10px] font-black uppercase tracking-[0.2em] text-blue-400 bg-blue-400/10 border border-blue-400/20 px-3 py-1 rounded-full shadow-lg">
            {job.category}
          </span>
          <div className="text-right">
            <span className="text-lg font-mono font-bold text-white tracking-tighter">
              KES {job.budget.toLocaleString()}
            </span>
            <p className="text-[8px] font-black text-slate-600 uppercase tracking-widest mt-0.5">Budgeted Escrow</p>
          </div>
        </div>
        <h3 className="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">{job.title}</h3>
        <p className="text-slate-400 text-xs mb-6 line-clamp-2 leading-relaxed font-medium">
          {job.description}
        </p>
        
        <div className="flex items-center gap-5 text-[9px] font-black uppercase tracking-[0.2em] text-slate-500">
          <div className="flex items-center gap-1.5">
            <Clock size={14} className="text-slate-600" />
            <span>{job.deadline}</span>
          </div>
          <div className="flex items-center gap-1.5">
            <MapPin size={14} className="text-slate-600" />
            <span>{job.campus}</span>
